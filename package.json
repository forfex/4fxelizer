{
  "name": "4fxelizer",
  "productName": "4FXELIZER",
  "version": "1.0.0",
  "description": "Make your models retro",
  "private": true,
  "author": "4FX",
  "license": "MIT",
  "homepage": "https://github.com/forfex/4fxelizer",
  "repository": {
    "type": "git",
    "url": "https://github.com/forfex/4fxelizer.git"
  },
  "main": "./out/main/index.js",
  "desktopName": "4fxelizer.desktop",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gpu-report": "electron-vite preview -- --gpu-report",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@webgpu/types": "^0.1.74",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^8.3.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
